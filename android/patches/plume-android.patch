--- /dev/null
+++ b/plume_android_surface.h
@@ -0,0 +1,18 @@
+// Copyright (c) 2026 contributors. Licensed under the MIT license.
+#pragma once
+namespace plume {
+template<class Window, class Surface>
+bool androidSurfaceNeedsRetry(Window pending, Surface surface) {
+    return pending != nullptr || surface == Surface{};
+}
+// Replacement owns a reference transferred from the pending slot. With no new
+// window, retain the current reference for repeated surface-creation attempts.
+template<class Window, class Release>
+Window adoptAndroidWindow(Window& current, Window replacement, Release release) {
+    if (replacement != nullptr) {
+        if (current != nullptr) release(current);
+        current=replacement;
+    }
+    return current;
+}
+}
diff --git a/plume_android_failure.h b/plume_android_failure.h
new file mode 100644
index 0000000..35508db
--- /dev/null
+++ b/plume_android_failure.h
@@ -0,0 +1,36 @@
+#pragma once
+#ifdef __ANDROID__
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+namespace plume {
+// A failed GPU submission cannot safely be followed by waits, draws or teardown
+// GPU waits. Stop the isolated game process; the launcher and app data survive.
+[[noreturn]] inline void failAndroidVulkan(const char* operation, int32_t result,
+    uint32_t queueType = 0, uint32_t familyIndex = UINT32_MAX) {
+    static std::mutex failureMutex;
+    const std::lock_guard lock(failureMutex);
+    const char* reason = result == -4 ? "VK_ERROR_DEVICE_LOST" : result == 2 ? "VK_TIMEOUT" : "Vulkan failure";
+    char message[1024];
+    std::snprintf(message, sizeof(message),
+        "Graphics stopped after %s.\nOperation: %s; VkResult=%d (0x%X); queueType=%u; family=%u.\n"
+        "The game process is exiting to prevent invalid GPU work. Copy or save the crash report in the launcher.\n",
+        reason, operation, result, static_cast<uint32_t>(result), queueType, familyIndex);
+    std::fprintf(stderr, "[plume] FATAL: %s", message);
+    if (const char* dir = std::getenv("APP_FOLDER_PATH")) {
+        char path[4096];
+        int n = std::snprintf(path, sizeof(path), "%s/graphics-failure.txt", dir);
+        if (n > 0 && n < static_cast<int>(sizeof(path))) {
+            if (FILE* file = std::fopen(path, "w")) {
+                std::fputs(message, file);
+                std::fclose(file);
+            }
+        }
+    }
+    std::fflush(stderr);
+    std::fflush(stdout);
+    std::_Exit(EXIT_FAILURE);
+}
+}
+#endif
