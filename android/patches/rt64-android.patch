+#pragma once
+// Startup-only diagnostics: stderr is captured in the app-private Android log.
+#ifdef __ANDROID__
+#include <cstdio>
+#include <ctime>
+#include <unistd.h>
+namespace RT64 {
+inline void androidStartupLog(const char* stage) {
+    timespec now{};
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    std::fprintf(stderr, "[RT64 startup] %lldms tid=%d: %s\n",
+        static_cast<long long>(now.tv_sec) * 1000 + now.tv_nsec / 1000000,
+        static_cast<int>(gettid()), stage);
+}
+}
+#else
+namespace RT64 { inline void androidStartupLog(const char*) {} }
+#endif
